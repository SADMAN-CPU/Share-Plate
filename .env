 
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=share_plate_db

# JWT — MUST be a long random secret (min 32 chars)
JWT_SECRET=shareplate_super_secret_jwt_key_2024_do_not_share_this_ever
JWT_EXPIRES_IN=7d

# Bcrypt rounds (10 is fine for dev, 12 for production)
BCRYPT_ROUNDS=10

# CORS — comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Cron schedule for food expiry checker (every 15 minutes)
EXPIRY_CRON=*/15 * * * *
